# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27027/rebu?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173

# OTP: "mock" logs the code (and the demo number always uses DEMO_OTP).
# Production: OTP_PROVIDER=msg91 (MSG91_AUTH_KEY + MSG91_TEMPLATE_ID, template var ##OTP##)
# or OTP_PROVIDER=twilio (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM).
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DEMO_PHONE=9999999999
DEMO_OTP=123456

# Agora — App Certificate must stay on the server. Leave blank to run without real media.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600

# Razorpay (test keys start with rzp_test_). Secret stays on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push notifications (Firebase Cloud Messaging). Path to the service-account JSON
# from Firebase console → Project settings → Service accounts. Blank = no push.
FCM_SERVICE_ACCOUNT=

# Uploads: local (disk, dev only) or cloudinary (CLOUDINARY_URL=cloudinary://key:secret@cloud_name)
STORAGE=local
CLOUDINARY_URL=
